<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
	<module name="global">
		<param name="randomSeed" value="4711" />
		<param name="coordinateSystem" value="EPSG:5179" />
	</module>

	<module name="network">
		<param name="inputNetworkFile" value="jeonggwan-network-expanded.xml" />
	</module>

	<module name="plans">
		<param name="inputPlansFile" value="jeonggwan-plans-v4.xml" />
	</module>


	<module name="transit">
		<param name="useTransit" value="true" />
		<param name="transitScheduleFile" value="regional-transit-schedule.xml" />
		<param name="vehiclesFile" value="regional-transit-vehicles.xml" />
		<param name="transitModes" value="pt" />
	</module>

	<!-- Transit Router Configuration: Optimize for Jeonggwan regional connectivity -->
	<module name="transitRouter">
		<!-- 출발/도착지에서 정류장 탐색 반경 (기본 1000m → 2000m) -->
		<param name="searchRadius" value="2000" />
		<!-- 탐색 확장 반경 (기본 200m → 500m) -->
		<param name="extensionRadius" value="500" />
		<!-- 환승 시 도보 허용 거리 (기본 100m → 500m, 한국 도시 환경 반영) -->
		<param name="maxBeelineWalkConnectionDistance" value="500" />
		<!-- 직행 도보 비용 계수: PT보다 walk가 더 빠를 때만 walk 선택 -->
		<param name="directWalkFactor" value="1.0" />
		<!-- 최대 환승 횟수 (기본 2회 → 5회, O1→D2 같은 3회 환승 경로 허용) -->
		<param name="maxTransfers" value="5" />
	</module>


	<!-- Added planscalcroute for Walk Speed -->
	<module name="planscalcroute">
		<parameterset type="teleportedModeParameters">
			<param name="mode" value="walk" />
			<param name="teleportedModeSpeed" value="0.833333" /> 
			<!-- 3 km/h = 0.8333 m/s -->
			<param name="beelineDistanceFactor" value="1.3" />
		</parameterset>
		<parameterset type="teleportedModeParameters">
			<param name="mode" value="access_walk" />
			<param name="teleportedModeSpeed" value="0.833333" />
			<param name="beelineDistanceFactor" value="1.3" />
		</parameterset>
		<parameterset type="teleportedModeParameters">
			<param name="mode" value="egress_walk" />
			<param name="teleportedModeSpeed" value="0.833333" />
			<param name="beelineDistanceFactor" value="1.3" />
		</parameterset>
	</module>

	<module name="controler">
		<param name="outputDirectory" value="./output/jeonggwan-v6-regional" />
		<param name="firstIteration" value="0" />
		<param name="lastIteration" value="100" />
		<param name="eventsFileFormat" value="xml" />
		<param name="mobsim" value="qsim" />
		<param name="writePlansInterval" value="10" />
		<param name="writeEventsInterval" value="10" />
		<param name="overwriteFiles" value="deleteDirectoryIfExists" />
	</module>

	<module name="qsim">
		<param name="startTime" value="00:00:00" />
		<param name="endTime" value="30:00:00" />
		<param name="simStarttimeInterpretation" value="onlyUseStarttime" />
	</module>

	<module name="scoring">
		<param name="learningRate" value="1.0" />
		<param name="brainExpBeta" value="2.0" />
		<param name="fractionOfIterationsToStartScoreMSA" value="0.9" />

		<!-- 1. Default Subpopulation -->
		<parameterset type="scoringParameters">
			<param name="subpopulation" value="default" />
			<param name="performing" value="6.88" />
			<param name="marginalUtilityOfMoney" value="1.0" />
			<param name="lateArrival" value="-18.0" />
			<param name="earlyDeparture" value="-0.0" />

			<parameterset type="modeParams">
				<param name="mode" value="car"/>
				<param name="constant" value="0.0" />
				<param name="dailyMonetaryConstant" value="-3.5" />
				<param name="monetaryDistanceRate" value="-2.0E-4" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="pt"/>
				<param name="constant" value="-1.5" />
				<param name="dailyMonetaryConstant" value="-1.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="walk"/>
				<param name="constant" value="0.0" />
				<param name="marginalUtilityOfDistance_util_m" value="-0.0005" /> 
				<!-- Updated to match Young for default -->
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="sav"/>
				<param name="constant" value="-0.7" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="drt"/>
				<param name="constant" value="-1.5" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="home" />
				<param name="typicalDuration" value="12:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="work" />
				<param name="typicalDuration" value="08:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="education" />
				<param name="typicalDuration" value="06:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="shopping" />
				<param name="typicalDuration" value="01:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="leisure" />
				<param name="typicalDuration" value="02:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="other" />
				<param name="typicalDuration" value="01:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="pick_drop" />
				<param name="typicalDuration" value="00:15:00" />
			</parameterset>
		</parameterset>

		<!-- 2. Young Subpopulation -->
		<parameterset type="scoringParameters">
			<param name="subpopulation" value="young" />
			<param name="performing" value="6.88" />
			<param name="marginalUtilityOfMoney" value="1.0" />
			<param name="lateArrival" value="-18.0" />
			<param name="earlyDeparture" value="-0.0" />
			
			<parameterset type="modeParams">
				<param name="mode" value="car"/>
				<param name="constant" value="-0.2" />
				<param name="dailyMonetaryConstant" value="-3.5" />
				<param name="monetaryDistanceRate" value="-2.0E-4" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="pt"/>
				<param name="constant" value="-1.5" />
				<param name="dailyMonetaryConstant" value="-1.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="walk"/>
				<param name="constant" value="0.0" />
				<param name="marginalUtilityOfDistance_util_m" value="-0.0005" />
				<!-- Updated from -0.0001 to -0.0005 -->
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="sav"/>
				<param name="constant" value="-0.2" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="drt"/>
				<param name="constant" value="-1.0" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="home" />
				<param name="typicalDuration" value="12:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="work" />
				<param name="typicalDuration" value="08:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="education" />
				<param name="typicalDuration" value="06:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="shopping" />
				<param name="typicalDuration" value="01:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="leisure" />
				<param name="typicalDuration" value="02:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="other" />
				<param name="typicalDuration" value="01:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="pick_drop" />
				<param name="typicalDuration" value="00:15:00" />
			</parameterset>
		</parameterset>

		<!-- 3. Elderly Subpopulation -->
		<parameterset type="scoringParameters">
			<param name="subpopulation" value="elderly" />
			<param name="performing" value="6.88" />
			<param name="marginalUtilityOfMoney" value="1.0" />
			<param name="lateArrival" value="-18.0" />
			<param name="earlyDeparture" value="-0.0" />
			
			<parameterset type="modeParams">
				<param name="mode" value="car"/>
				<param name="constant" value="0.0" />
				<param name="dailyMonetaryConstant" value="-3.5" />
				<param name="monetaryDistanceRate" value="-2.0E-4" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="pt"/>
				<param name="constant" value="-1.5" />
				<param name="dailyMonetaryConstant" value="-1.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="walk"/>
				<param name="constant" value="-3.0" />
				<!-- constant -1.0 -> -3.0 -->
				<param name="marginalUtilityOfDistance_util_m" value="-0.0010" />
				<!-- dist cost -0.0002 -> -0.0010 -->
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="sav"/>
				<param name="constant" value="-2.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="drt"/>
				<param name="constant" value="-2.5" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="home" />
				<param name="typicalDuration" value="12:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="work" />
				<param name="typicalDuration" value="08:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="education" />
				<param name="typicalDuration" value="06:00:00" />
			</parameterset>
			<parameterset type="activityParams">
