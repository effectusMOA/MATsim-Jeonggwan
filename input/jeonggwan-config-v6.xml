				<param name="typicalDuration" value="01:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="pick_drop" />
				<param name="typicalDuration" value="00:15:00" />
			</parameterset>
		</parameterset>

		<!-- 4. NULL Subpopulation (Fallback) -->
		<parameterset type="scoringParameters">
			<param name="lateArrival" value="-18.0" />
			<param name="earlyDeparture" value="-0.0" />
			<param name="performing" value="6.88" />
			<param name="marginalUtilityOfMoney" value="1.0" />
			
			<parameterset type="modeParams">
				<param name="mode" value="car"/>
				<param name="constant" value="0.0" />
				<param name="dailyMonetaryConstant" value="-3.5" />
				<param name="monetaryDistanceRate" value="-2.0E-4" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="pt"/>
				<param name="constant" value="-1.5" />
				<param name="dailyMonetaryConstant" value="-1.0" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="walk"/>
				<param name="constant" value="0.0" />
				<param name="marginalUtilityOfDistance_util_m" value="-0.0001" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="drt"/>
				<param name="constant" value="-1.5" />
			</parameterset>
			<parameterset type="modeParams">
				<param name="mode" value="sav"/>
				<param name="constant" value="-0.7" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="home" />
				<param name="typicalDuration" value="12:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="work" />
				<param name="typicalDuration" value="08:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="education" />
				<param name="typicalDuration" value="06:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="shopping" />
				<param name="typicalDuration" value="01:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="leisure" />
				<param name="typicalDuration" value="02:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="other" />
				<param name="typicalDuration" value="01:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="pick_drop" />
				<param name="typicalDuration" value="00:15:00" />
			</parameterset>
		</parameterset>
	</module>

	<module name="strategy">
		<param name="maxAgentPlanMemorySize" value="5" />



		<!-- Strategies for 'default' -->
		<parameterset type="strategysettings">
			<param name="strategyName" value="BestScore"/>
			<param name="subpopulation" value="default"/>
			<param name="weight" value="0.7"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="default"/>
			<param name="weight" value="0.1"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="TimeAllocationMutator"/>
			<param name="subpopulation" value="default"/>
			<param name="weight" value="0.1"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SubtourModeChoice"/>
			<param name="subpopulation" value="default"/>
			<param name="weight" value="0.1"/>
		</parameterset>

		<!-- Strategies for 'young' -->
		<parameterset type="strategysettings">
			<param name="strategyName" value="BestScore"/>
			<param name="subpopulation" value="young"/>
			<param name="weight" value="0.7"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="young"/>
			<param name="weight" value="0.1"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="TimeAllocationMutator"/>
			<param name="subpopulation" value="young"/>
			<param name="weight" value="0.1"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SubtourModeChoice"/>
			<param name="subpopulation" value="young"/>
			<param name="weight" value="0.1"/>
		</parameterset>

		<!-- Strategies for 'elderly' -->
		<parameterset type="strategysettings">
			<param name="strategyName" value="BestScore"/>
			<param name="subpopulation" value="elderly"/>
			<param name="weight" value="0.7"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="elderly"/>
			<param name="weight" value="0.1"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="TimeAllocationMutator"/>
			<param name="subpopulation" value="elderly"/>
			<param name="weight" value="0.1"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SubtourModeChoice"/>
			<param name="subpopulation" value="elderly"/>
			<param name="weight" value="0.1"/>
		</parameterset>

		<!-- Strategies for 'null' -->
		<parameterset type="strategysettings">
			<param name="strategyName" value="BestScore"/>
			<param name="subpopulation" value="null"/>
			<param name="weight" value="0.7"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute"/>
			<param name="subpopulation" value="null"/>
			<param name="weight" value="0.1"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="TimeAllocationMutator"/>
			<param name="subpopulation" value="null"/>
			<param name="weight" value="0.1"/>
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="SubtourModeChoice"/>
			<param name="subpopulation" value="null"/>
			<param name="weight" value="0.1"/>
		</parameterset>
	</module>

	<module name="subtourModeChoice">
		<param name="modes" value="car,pt,walk,drt,sav" />
		<param name="chainBasedModes" value="car" />
		<param name="considerCarAvailability" value="true" />
		<param name="coordDistance" value="0.0" />
	</module>

	<module name="multiModeDrt">
		<!-- DRT Mode (Stop-based, large capacity) -->
		<parameterset type="drt">
			<parameterset type="ExtensiveInsertionSearch"/>
			
			<param name="mode" value="drt" />
			<param name="operationalScheme" value="stopbased" />
			<param name="transitStopFile" value="jeonggwan-drt-stops.xml"/>
			<param name="vehiclesFile" value="jeonggwan-drt-vehicles-v3.xml"/>
			
			<param name="maxWaitTime" value="600.0" />
			<param name="maxTravelTimeAlpha" value="1.5" />
			<param name="maxTravelTimeBeta" value="300.0" />
			<param name="maxWalkDistance" value="1000.0" />
			<param name="stopDuration" value="60.0"/>
			
			<param name="idleVehiclesReturnToDepots" value="false" />
			<param name="useModeFilteredSubnetwork" value="false"/>
			<param name="rejectRequestIfMaxWaitOrTravelTimeViolated" value="false" />
			<param name="writeDetailedCustomerStats" value="true"/>
			<param name="changeStartLinkToLastLinkInSchedule" value="true" />
			
			<parameterset type="drtfare">
				<!-- DRT: 마을버스 수준 요금 -->
				<!-- basefare: 1,500 KRW = 1.0 EUR -->
				<param name="basefare" value="1.0"/>
				<param name="minFarePerTrip" value="1.0"/>
				<param name="dailySubscriptionFee" value="0.0"/>
				<!-- distanceFare: 150 KRW/km = 0.0001 EUR/m -->
				<param name="distanceFare_m" value="0.0001"/>
				<param name="timeFare_h" value="0.0"/>
			</parameterset>
			
			<parameterset type="zonalSystem">
				<parameterset type="SquareGridZoneSystem">
					<param name="cellSize" value="500"/>
				</parameterset>
			</parameterset>
		</parameterset>

		<!-- SAV Mode (Door-to-door, small capacity) -->
		<parameterset type="drt">
			<parameterset type="ExtensiveInsertionSearch"/>
			
			<param name="mode" value="sav" />
			<param name="operationalScheme" value="door2door" />
			<param name="vehiclesFile" value="jeonggwan-sav-vehicles-v3.xml"/>
			
			<param name="maxWaitTime" value="300.0" />
			<param name="maxTravelTimeAlpha" value="1.5" />
			<param name="maxTravelTimeBeta" value="300.0" />
			<param name="stopDuration" value="30.0"/>
			
			<param name="idleVehiclesReturnToDepots" value="false" />
			<param name="useModeFilteredSubnetwork" value="false"/>
			<param name="rejectRequestIfMaxWaitOrTravelTimeViolated" value="false" />
			<param name="writeDetailedCustomerStats" value="true"/>
			<param name="changeStartLinkToLastLinkInSchedule" value="true" />
			
			<parameterset type="drtfare">
				<!-- SAV: 택시형 요금 (택시보다 저렴) -->
				<!-- basefare: 3,750 KRW = 2.5 EUR -->
				<param name="basefare" value="2.5"/>
				<param name="minFarePerTrip" value="2.5"/>
				<param name="dailySubscriptionFee" value="0.0"/>
				<!-- distanceFare: 600 KRW/km = 0.0004 EUR/m (DRT의 4배) -->
				<param name="distanceFare_m" value="0.0004"/>
				<param name="timeFare_h" value="0.0"/>
			</parameterset>
			
			<parameterset type="zonalSystem">
				<parameterset type="SquareGridZoneSystem">
					<param name="cellSize" value="500"/>
				</parameterset>
			</parameterset>
		</parameterset>
	</module>

	<module name="dvrp">
		<param name="mobsimMode" value="car"/>
		<param name="networkModes" value="car"/>
		<param name="travelTimeEstimationAlpha" value="0.05"/>
		<param name="travelTimeEstimationBeta" value="0.0"/>
		
		<parameterset type="travelTimeMatrix">
			<parameterset type="SquareGridZoneSystem">
				<param name="cellSize" value="500"/>
			</parameterset>
			<param name="maxNeighborDistance" value="5000"/>
		</parameterset>
	</module>

</config>
