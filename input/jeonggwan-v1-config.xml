<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
	<!-- Jeonggwan V1: Regional Network with Full PT Coverage -->
	<!-- Includes: 부산, 울산, 양산, 김해, 경주, 포항, 밀양, 창원 -->
	
	<module name="global">
		<param name="randomSeed" value="4711" />
		<param name="coordinateSystem" value="EPSG:5179" />
		<param name="numberOfThreads" value="8" />
	</module>

	<module name="network">
		<param name="inputNetworkFile" value="regional-network-expanded.xml" />
	</module>

	<module name="plans">
		<param name="inputPlansFile" value="jeonggwan-plans-excel.xml" />
	</module>

	<module name="transit">
		<param name="useTransit" value="true" />
		<param name="transitScheduleFile" value="regional-transit-schedule.xml"/>
		<param name="vehiclesFile" value="regional-transit-vehicles.xml"/>
		<param name="transitModes" value="pt"/>
	</module>

	<module name="controler">
		<param name="outputDirectory" value="./output/jeonggwan-v1" />
		<param name="firstIteration" value="0" />
		<param name="lastIteration" value="50" />
		<param name="mobsim" value="qsim" />
		<param name="writeEventsInterval" value="10" />
		<param name="writePlansInterval" value="10" />
		<param name="overwriteFiles" value="deleteDirectoryIfExists" />
	</module>

	<module name="qsim">
		<param name="startTime" value="00:00:00" />
		<param name="endTime" value="30:00:00" />
		<param name="flowCapacityFactor" value="1.0" />
		<param name="storageCapacityFactor" value="1.0" />
		<param name="numberOfThreads" value="8" />
		<param name="mainMode" value="car" />
		<param name="vehiclesSource" value="defaultVehicle" />
	</module>

	<module name="swissRailRaptor">
		<param name="useIntermodalAccessEgress" value="true"/>
		<param name="intermodalAccessEgressModeSelection" value="CalcLeastCostModePerStop"/>
		<parameterset type="intermodalAccessEgress">
			<param name="mode" value="walk"/>
			<param name="maxRadius" value="1500"/>
			<param name="initialSearchRadius" value="500"/>
			<param name="searchExtensionRadius" value="500"/>
		</parameterset>
	</module>

	<module name="planCalcScore">
		<parameterset type="scoringParameters">
			<param name="lateArrival" value="-18" />
			<param name="earlyDeparture" value="-18" />
			<param name="performing" value="6.0" />
			<param name="marginalUtilityOfMoney" value="1.0" />
			
			<!-- Car mode -->
			<parameterset type="modeParams">
				<param name="mode" value="car" />
				<param name="constant" value="-1.0" />
				<param name="dailyMonetaryConstant" value="0.0" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
				<param name="monetaryDistanceRate" value="-0.0002" />
			</parameterset>

			<!-- Walk mode -->
			<parameterset type="modeParams">
				<param name="mode" value="walk" />
				<param name="constant" value="0.0" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
			</parameterset>

			<!-- PT mode -->
			<parameterset type="modeParams">
				<param name="mode" value="pt" />
				<param name="constant" value="0.5" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
			</parameterset>

			<!-- Activity parameters -->
			<parameterset type="activityParams">
				<param name="activityType" value="home" />
				<param name="typicalDuration" value="12:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="work" />
				<param name="typicalDuration" value="08:00:00" />
				<param name="openingTime" value="07:00:00" />
				<param name="latestStartTime" value="09:00:00" />
				<param name="closingTime" value="18:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="education" />
				<param name="typicalDuration" value="06:00:00" />
				<param name="openingTime" value="08:00:00" />
				<param name="closingTime" value="16:00:00" />
			</parameterset>
			<parameterset type="activityParams">
				<param name="activityType" value="other" />
				<param name="typicalDuration" value="01:00:00" />
			</parameterset>
		</parameterset>
	</module>

	<module name="strategy">
		<param name="maxAgentPlanMemorySize" value="5" />
		<parameterset type="strategysettings">
			<param name="strategyName" value="BestScore" />
			<param name="weight" value="0.7" />
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute" />
			<param name="weight" value="0.2" />
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="TimeAllocationMutator" />
			<param name="weight" value="0.1" />
		</parameterset>
	</module>
</config>
